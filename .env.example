# Copie para .env.local e preencha. NUNCA versione valores reais.
# Cada ambiente (DEV, HOMOLOGAÇÃO, PRODUÇÃO) usa um projeto Supabase e segredos próprios.

# --- Públicas (vão para o navegador) ---------------------------------------
# URL pública da aplicação (usada em links de e-mail e QR Codes).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
# URL do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publishable (anon). Segura no navegador: o acesso é limitado por RLS.
# Local: `npx supabase status -o env` (ANON_KEY) ou `node scripts/stack/chaves.mjs`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secretas (somente servidor) -------------------------------------------
# Service role: ignora RLS. Usada apenas em src/lib/supabase/admin.ts.
# Local: SERVICE_ROLE_KEY de `npx supabase status -o env` ou `node scripts/stack/chaves.mjs`.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo (mín. 32 caracteres) para HMAC dos relatórios e autenticação do worker.
REPORT_SIGNING_SECRET=

# --- Opcionais --------------------------------------------------------------
# Sentry (deixe vazio para desativar).
SENTRY_DSN=
